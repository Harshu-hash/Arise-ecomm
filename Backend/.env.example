NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arise_ecomm?retryWrites=true&w=majority

# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
BULLMQ_ENABLED=true

# Rate limiting (per client IP, per minute; auth routes use a stricter built-in limit)
RATE_LIMIT_MAX=300

# Security
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# SMTP email (leave EMAIL_HOST empty in dev to skip sending)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Arise <no-reply@yourdomain.com>

# Razorpay (webhook URL: <PUBLIC_ORIGIN>/webhooks/v1/payments/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Operations
# Bearer token for GET /metrics (min 32 chars). Unset = endpoint disabled.
METRICS_TOKEN=
# Optional: restrict /api/admin to these IPs/CIDRs (comma separated)
ADMIN_IP_ALLOWLIST=

# File uploads (images, videos, PDFs) on local disk.
# Dev: relative folder inside Backend. Live server: UPLOAD_DIR=/var/www/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_BYTES=104857600
